<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light" />
  <title><%= @doubtfire_product_name %> notifications</title>
  <style type="text/css">
    a { text-decoration: none; }
    a:hover { text-decoration: underline; }
    @media only screen and (max-width: 640px) {
      .main { padding: 20px 16px !important; }
      .unit-card { padding: 14px 16px !important; }
      .notification-heading { align-items: flex-start !important; flex-direction: column !important; gap: 2px !important; }
    }
  </style>
</head>
<body style="margin:0; padding:0; background-color:#ffffff;">
  <div style="padding:40px 16px; font-family:Roboto,-apple-system,BlinkMacSystemFont,'Segoe UI','Helvetica Neue',Helvetica,Arial,sans-serif; color:#333; font-size:14px;">
    <div style="width:100%; max-width:800px; margin:0 auto;">
      <main class="main" style="font-family:Roboto,-apple-system,BlinkMacSystemFont,'Segoe UI','Helvetica Neue',Helvetica,Arial,sans-serif; border:solid 1px rgb(240,240,240); padding:30px 40px;">
        <header style="display:flex; align-items:flex-start; justify-content:space-between; gap:16px;">
          <div style="font-size:1.1em; font-weight:bold; color:#333; line-height:1.4;">
            Notification Summary
            <div style="color:#aaa; font-size:0.7em; font-weight:normal; padding-top:4px;">
              <%= "#{Time.zone.now.day.ordinalize} #{Time.zone.now.strftime('%B %Y')}" %>
            </div>
          </div>
          <img src="<%= @doubtfire_host %>/assets/images/logo.png" alt="<%= @doubtfire_product_name %>" style="display:block; width:60px; height:35px; border:0; flex:none;" />
        </header>

        <p style="margin:20px 0 0; line-height:1.6;">Hi <%= @recipient.first_name %>,</p>

        <p style="margin:8px 0 20px; line-height:1.6;">
          You have <%= @notification_count %> new
          <%= 'notification'.pluralize(@notification_count) %> in <%= @doubtfire_product_name %>.
        </p>

        <% @units.each do |section| %>
          <section class="unit-card" style="font-family:Roboto,-apple-system,BlinkMacSystemFont,'Segoe UI','Helvetica Neue',Helvetica,Arial,sans-serif; border:solid 1px rgb(240,240,240); padding:16px 20px; margin:0 0 16px;">
            <div style="font-size:0.75em; color:#aaa; letter-spacing:0.8px; text-transform:uppercase; font-weight:bold; line-height:1.4;">
              <%= section[:unit].code %>
            </div>
            <div style="font-size:1em; color:#333; font-weight:bold; line-height:1.4; padding:2px 0 12px;">
              <%= section[:unit].name %>
            </div>

            <% section[:group_sections].each do |group_section| %>
              <% if group_section[:divider] %>
                <hr style="border:0; border-top:solid 1px rgb(225,225,225); margin:20px 0 10px;" />
              <% end %>
              <% if group_section[:heading] %>
                <div style="font-size:0.95em; color:#333; font-weight:bold; line-height:1.4; padding:8px 0;">
                  <%= group_section[:heading] %>
                </div>
              <% end %>
              <% group_section[:groups].each do |group| %>
                <article class="notification-box" style="font-family:Roboto,-apple-system,BlinkMacSystemFont,'Segoe UI','Helvetica Neue',Helvetica,Arial,sans-serif; background:#fafafa; border-left:4px solid <%= group[:severity] == 'critical' ? '#c62828' : group[:severity] == 'warning' ? '#ed6c02' : '#1565c0' %>; padding:14px 16px; margin:0 0 10px; line-height:1.55;">
                  <div class="notification-heading" style="display:flex; align-items:flex-start; justify-content:space-between; gap:16px; padding-bottom:2px;">
                    <div style="min-width:0; font-weight:bold; color:#333; font-size:1.1em; line-height:1.4;">
                      <% if group[:task] %>
                        <%= group[:task][:abbreviation] %> - <%= group[:task][:name] %>
                      <% elsif group[:message_subject].present? %>
                        <%= group[:message_subject] %>
                      <% elsif group[:project_id] %>
                        Portfolio
                      <% else %>
                        Unit notification
                      <% end %>
                    </div>
                    <% if group_section[:kind] && group.dig(:task, :due_date) %>
                      <div style="flex:none; font-weight:bold; color:#333; font-size:1.1em; line-height:1.4; white-space:nowrap;">
                        <%= notification_due_date(group) %>
                      </div>
                    <% end %>
                  </div>
                  <% if group[:task] && group[:task][:student_name].present? %>
                    <div style="color:#777; font-size:0.85em;"><%= group[:task][:student_name] %></div>
                  <% end %>
                  <% unless group_section[:kind] && group[:event_count] == group[:counts][group_section[:kind]] %>
                    <div style="color:#555;"><%= group[:detail] %></div>
                  <% end %>
                  <% unless group_section[:kind] %>
                    <div style="color:#aaa; font-size:0.8em; padding-top:2px;"><%= notification_timestamp(group) %></div>
                  <% end %>
                  <% if group[:task] %>
                    <div style="padding-top:4px;">
                      <a href="<%= @doubtfire_host %>/projects/<%= group[:task][:project_id] %>/dashboard/<%= group[:task][:abbreviation] %><%= '?tutor=true' if group[:task][:staff_view] %>" target="_blank" rel="noopener noreferrer" style="color:#6a97d2; font-size:0.9em;">
                        View this task
                      </a>
                    </div>
                  <% elsif group[:project_id] %>
                    <div style="padding-top:4px;">
                      <a href="<%= @doubtfire_host %>/projects/<%= group[:project_id] %>/portfolio" target="_blank" rel="noopener noreferrer" style="color:#6a97d2; font-size:0.9em;">
                        View your portfolio
                      </a>
                    </div>
                  <% end %>
                </article>
              <% end %>
            <% end %>
          </section>
        <% end %>

        <div style="margin:20px 0 0; text-align:center;">
          <a href="<%= @notification_url %>" target="_blank" rel="noopener noreferrer" style="display:inline-block; padding:10px 22px; color:#6a97d2; font-size:0.95em; font-weight:bold; line-height:1.4; border:solid 1px rgb(225,225,225); border-radius:4px; background:#ffffff;">
            View all notifications
          </a>
        </div>
      </main>

      <footer style="font-family:Roboto,-apple-system,BlinkMacSystemFont,'Segoe UI','Helvetica Neue',Helvetica,Arial,sans-serif; padding:16px 8px 0; color:#aaa; font-size:0.75em; line-height:1.6; text-align:center;">
        <div>You are receiving this because you have email notifications turned on in <%= @doubtfire_product_name %>.</div>
        <div style="padding-top:4px;">
          <a href="<%= @unsubscribe_url %>" target="_blank" rel="noopener noreferrer" style="color:#aaa; text-decoration:underline;">Unsubscribe or change your settings</a>
        </div>
      </footer>
    </div>
  </div>
</body>
</html>
